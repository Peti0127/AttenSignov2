<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>f923210a-0c4b-4be8-b938-9c7b42db9624</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Hausbetreuung Attensam GmbH</ProviderName>
  <DefaultLocale>de-AT</DefaultLocale>
  <DisplayName DefaultValue="Attensam Signatur" />
  <Description DefaultValue="Erstellt eine Outlook-Signatur aus dem Microsoft-365-Benutzerprofil." />
  <IconUrl DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-256.png" />
  <HighResolutionIconUrl DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-128.png" />
  <SupportUrl DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/support.html" />
  <AppDomains>
    <AppDomain>https://peti0127.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="Signature.Group">
                <Label resid="Group.Label" />
                <Control xsi:type="Button" id="Signature.Button">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Description" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Signatur" />
        <bt:String id="Button.Label" DefaultValue="Signatur einfügen" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Description" DefaultValue="Profildaten laden und die Signatur einfügen." />
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Autorun.Url">
              <Override type="javascript" resid="AutorunJs.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Taskpane.Url" />
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="Signature.Group">
                  <Label resid="Group.Label" />
                  <Control xsi:type="Button" id="Signature.Button">
                    <Label resid="Button.Label" />
                    <Supertip>
                      <Title resid="Button.Label" />
                      <Description resid="Button.Description" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16" />
                      <bt:Image size="32" resid="Icon.32" />
                      <bt:Image size="80" resid="Icon.80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="autoInsertSignature" />
              </LaunchEvents>
              <SourceLocation resid="Autorun.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-16.png" />
          <bt:Image id="Icon.32" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-32.png" />
          <bt:Image id="Icon.80" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/Images/Icons/Icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/taskpane.html" />
          <bt:Url id="Autorun.Url" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/autorun.html" />
          <bt:Url id="AutorunJs.Url" DefaultValue="https://peti0127.github.io/AttenSignov2/Resources/autorun.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Signatur" />
          <bt:String id="Button.Label" DefaultValue="Signatur einfügen" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Description" DefaultValue="Profildaten laden und die Signatur einfügen." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
